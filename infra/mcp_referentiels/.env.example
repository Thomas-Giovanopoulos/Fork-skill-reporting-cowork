# ─── Référentiels du skill ────────────────────────────────────────────────────
# DSN de la base des référentiels. DÉLIBÉRÉMENT distinct de DATABASE_URL :
# c'est cette variable, et elle seule, qui garantit la séparation d'avec la
# projection du datahub (D33). Ne jamais y mettre le DSN du datahub.
# Mot de passe = celui choisi pour ref_mcp à l'étape 2.3 du RUNBOOK.
REFERENTIELS_DATABASE_URL=postgresql://ref_mcp:MOT_DE_PASSE@localhost:5432/rhetores_ref

# ─── Registre utilisateurs (qui est administrateur) ───────────────────────────
# ATTENTION — variable DIFFÉRENTE de la précédente, et base différente.
# Sa PRÉSENCE fait basculer rhetores_authz sur le backend Postgres (D12) ;
# absente, le registre est lu depuis users.json / USERS_JSON.
# En boucle de dev on la laisse VIDE et on fournit users.json : c'est valide.
# Si elle est vide ET que users.json manque, tout appel authentifié répond
# 403 « Utilisateur non référencé » alors que le token est bon — le symptôme
# ressemble à un problème d'auth, c'est un fichier absent.
DATABASE_URL=
# USERS_FILE=users.json
# USERS_JSON=
# USERS_CACHE_TTL=300

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Choisir UN mode (validation déléguée à rhetores_authz, fix S11 : aud ET iss
# vérifiés dans les deux modes) :
#   Recette (HS256)    : définir JWT_SECRET uniquement
#   Production (RS256) : définir AZURE_TENANT_ID + AZURE_AUDIENCE, supprimer JWT_SECRET
JWT_SECRET=
# JWT_AUDIENCE : audience attendue en HS256 (défaut : valeur d'AZURE_AUDIENCE)
JWT_AUDIENCE=
# JWT_ISSUER : issuer attendu en HS256 (défaut : "rhetores-finance")
JWT_ISSUER=
AZURE_TENANT_ID=
AZURE_AUDIENCE=api://mcp-rhetores

# ─── Transport ────────────────────────────────────────────────────────────────
# Protection anti DNS-rebinding (spec MCP 2025-11-25) : doit couvrir le client.
ALLOWED_ORIGINS=https://claude.ai
# 8001 et non 8000 : mcp-o2s-server occupe 8000 en dev local.
PORT=8001
LOG_LEVEL=INFO

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  // Plafond de sécurité devicePixelRatio : évite qu'un DPR aberrant (lu pendant une transition
  // d'affichage — ex. bascule Mac -> vidéoprojecteur en mode "dupliquer") ne fasse calculer par
  // Chart.js un buffer de canvas disproportionné, provoquant une perte de contexte WebGL/2D
  // (icône "sad face" de Chrome). 2x couvre tous les écrans Retina réels sans perte visible.
  if(window.Chart){ Chart.defaults.devicePixelRatio = Math.min(window.devicePixelRatio||1, 2); }
</script>

<!-- HERO -->
<div class="hero">
  <div class="hero-swarm" aria-hidden="true"></div>
  {% if false %}
  <div class="hero-eclat" aria-hidden="true"></div>
    <div class="hero-bee" aria-hidden="true">
      <div class="hero-bee-fly">
        <img class="bee-img" src="data:image/png;base64," alt="Abeille Rhétorès"/>
      </div>
    </div>
  {% endif %}
  <div class="hero-top">
    <div>
      <div class="brand-name">Rhétorès Finance</div>
      <div class="brand-sub">Gestion de Patrimoine</div>
    </div>
    <div class="hero-ref">Reporting consolidé<br>{{ reporting.date_display }}<br>Confidentiel</div>
  </div>
  <div class="hero-main">
    <div class="hero-title">{{ reporting.client_label_html | safe }}</div>
    <div class="hero-kpi">
      <div class="kpi-lbl">Capitaux sous supervision</div>
      <div class="kpi-val hero-kpi-val" data-slot="actif_brut">{{ data.hero.get('actif_brut') or '&mdash;' }}</div>
    </div>
  </div>
  <script>
  (function(){
    var hero=document.currentScript.parentNode;
    var swarm=hero.querySelector('.hero-swarm'); if(!swarm) return;
    if(({{ 'true' if reporting.get('mode','presentee') == 'presentee' else 'false' }})) return;   // présentée : aucune abeille
    var SRC="data:image/png;base64,";
    var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
    var FLIGHT=3.4, WAVE=1.9, sp=150, off=75, bw=54, bh=bw*106/153;
    function build(animate){
      swarm.innerHTML='';
      var W=hero.clientWidth||1000, H=hero.clientHeight||300, cx=W/2, cy=H*0.5;
      var cells=[], maxd=1;
      var R=Math.ceil(H/sp)+3, C=Math.ceil(W/sp)+3;
      function add(x,y){ if(x<-bw||x>W+bw||y<-bh||y>H+bh) return;
        var d=Math.sqrt((x-cx)*(x-cx)+(y-cy)*(y-cy)); if(d>maxd)maxd=d; cells.push({x:x,y:y,d:d}); }
      for(var j=-R;j<=R;j++) for(var i=-C;i<=C;i++){
        add(cx+i*sp, cy+j*sp);              // grille A (abeille centrale à i=j=0)
        add(cx+off+i*sp, cy+off+j*sp);      // grille B (demi-décalage, comme le tile)
      }
      cells.forEach(function(c){
        var b=document.createElement('img'); b.src=SRC; b.className='swarm-bee'; b.alt='';
        b.style.width=bw+'px'; b.style.left=(c.x-bw/2)+'px'; b.style.top=(c.y-bh/2)+'px';
        if(animate){ b.style.animationDelay=(FLIGHT+(c.d/maxd)*WAVE).toFixed(2)+'s'; }
        else { b.style.animation='none'; b.style.opacity='0.22'; }
        swarm.appendChild(b);
      });
    }
    var animate = false;
    build(animate);
    var tmr; window.addEventListener('resize',function(){clearTimeout(tmr);tmr=setTimeout(function(){build(false);},200);});
  })();
  </script>
</div>
